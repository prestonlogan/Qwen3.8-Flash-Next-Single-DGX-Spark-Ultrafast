# Copy to .env and uncomment what you want to change; `docker compose up -d --wait` picks it up.
# The values shown are the defaults baked into compose.yaml.

# Serving profile. fast (this recipe's default, Hibana's own default): 3-bit experts and trunk copies, about twice as
# fast as exact. exact: NVFP4 experts and exact acceptance, ~47 tok/s. throughput: fast, tuned for many requests.
#PROFILE=fast
# Tuning for PROFILE=fast. v1.1 (default): this recipe's distilled MTP draft head (1.2 GB extra download), a
# repetition guard with a late </think> ramp, GB10 kernels, and lightly relaxed acceptance (top-3 rule at temperature
# 0, accept_soft 0.35 when sampling). v1.1-exact: the same with exact acceptance (output follows the served model
# exactly; slower at temperature 0). stock: Hibana's own fast settings (accept_soft 0.5), as in v1.0.0.
#TUNING=v1.1
# Where the distilled draft head is downloaded from (Hugging Face repo id).
#DRAFT_HEAD_REPO=prestonlogan/Qwen3.8-Flash-Next-MTP-Draft-Head
# Image input: 1 loads Qwen's vision tower (0.84 GiB) and accepts image_url parts; 0 serves text only.
#VISION=1
# Draft vocabulary rows: drafts from the most common tokens only (+3-10% on English and code; the model still
# verifies against the full vocabulary). Empty: 98304 with TUNING=v1.1, 131072 with stock. 0 drafts from all 248K
# rows; use it for mostly non-English text.
#DRAFT_VOCAB=
# Draft model: mtp (the checkpoint's own MTP head) or dflash2 (incoai's DFlash2 drafter, 1.2 GB extra download).
#PROPOSER=mtp
# Draft tokens per round; empty keeps the profile's (exact 4, fast adaptive up to 8). 0 turns speculation off.
#SPEC=
# Most requests decoded together; empty keeps the profile's (4 in exact and fast on one Spark, more in throughput).
# spark-bench-kit runs 4.
#PARALLEL=
# Largest prompt plus output per request. Requests share one KV pool sized to whatever memory is left.
#CONTEXT=262144

# Prefix cache tier on the NVMe, under DATA_DIR/ssd: on or off, and its cap in GiB (Hibana's default is 200).
#SSD=on
#SSD_GIB=100
# Memory Hibana leaves for everything else on the Spark (Hibana's default is 6). It takes the rest for its KV pools,
# and its memory guard stops the server when other programs eat into this.
#HOST_FLOOR_GIB=12

#HOST=0.0.0.0
#PORT=8888
# Docker restart policy. unless-stopped brings the server back after a reboot, and after an engine failure: the
# healthcheck (tools/health.sh) stops a server whose engine has failed so the container exits and restarts.
#RESTART=no

# Where the files go: the 135 GB checkpoint into the shared HF cache; 51 GB of 3-bit copies, the SSD tier and logs
# into DATA_DIR; first-use kernel builds into KERNEL_CACHE.
#HF_CACHE=~/.cache/huggingface
#DATA_DIR=~/.cache/hibana-flashnext
#KERNEL_CACHE=~/.cache/hibana-flashnext/kernels

# Bump the -rN tag with every Dockerfile change: `up` reuses an existing tag.
#HIBANA_IMAGE=hibana-flashnext-vision:d474b74d-v2
#HIBANA_COMMIT=d474b74d5a892b2cd1cc8fc50cb17946e2a539bb
# The checkpoints are public; a token only lifts rate limits.
#HF_TOKEN=
