+"""Python loader for Hybrid SM121 Fused HyperConnection.mix (M<=4 streaming v2, M=5..16 BF16 Tensor-Core v3)."""
+from __future__ import annotations
+
+import hashlib
+import os
+from functools import lru_cache
+from pathlib import Path
+
+import torch
+
+_DIR = Path(__file__).resolve().parent / "csrc"
+_SRC_V2 = _DIR / "hyper_mix_cuda.cu"
+_SRC_TC = _DIR / "hyper_mix_tc.cu"
+
+
+@lru_cache(maxsize=1)
+def _mod_v2():
+    from torch.utils.cpp_extension import load
+    from hibana.engine.config import current
+    os.environ.setdefault("TORCH_CUDA_ARCH_LIST", current().cuda_arch)
+    rev = hashlib.sha256(_SRC_V2.read_bytes()).hexdigest()[:16]
+    return load(name=f"hibana_hyper_mix_v2_{rev}", sources=[str(_SRC_V2)], extra_cuda_cflags=["-O3", "--use_fast_math"], verbose=False)
+
+
+@lru_cache(maxsize=1)
+def _mod_tc():
+    from torch.utils.cpp_extension import load
+    from hibana.engine.config import current
+    os.environ.setdefault("TORCH_CUDA_ARCH_LIST", current().cuda_arch)
+    rev = hashlib.sha256(_SRC_TC.read_bytes()).hexdigest()[:16]
+    return load(name=f"hibana_hyper_mix_tc_{rev}", sources=[str(_SRC_TC)], extra_cuda_cflags=["-O3", "--use_fast_math"], verbose=False)
+
+
+def hyper_mix_fp8_cuda(
+    normed: torch.Tensor,
+    w_down: torch.Tensor,
+    s_down: torch.Tensor,
+    w_up: torch.Tensor,
+    s_up: torch.Tensor,
+    hidden: int,
+) -> torch.Tensor:
+    m = normed.shape[0]
+    n_c = normed.contiguous()
+    sd = s_down.reshape(1).contiguous()
+    su = s_up.reshape(1).contiguous()
+    if m <= 4:
+        return _mod_v2().hyper_mix_fp8(n_c, w_down, sd, w_up, su, int(hidden))
+    return _mod_tc().hyper_mix_tc(n_c, w_down, sd, w_up, su, int(hidden))
