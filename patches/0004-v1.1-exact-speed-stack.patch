+def _quantize_w3_coord(weight: torch.Tensor, levels: tuple[float, ...], iters: int = 4):
+    """Coordinate-descent W3 quantization (group_size=32) with closed-form E4M3 group scales and FP32 row scales."""
+    from hibana.kernels import w3
+    n, k = weight.shape
+    lv = torch.tensor(levels, device=weight.device, dtype=torch.float32)
+    mids = (lv[1:] + lv[:-1]) / 2.0
+    g = weight.reshape(n, k // w3.GROUP, w3.GROUP)
+    amax = g.abs().amax(-1)
+    row_scale = (amax.amax(-1) / (lv[-1] * w3.FP8_MAX)).clamp_min(1e-12)
+    sc = ((amax / (lv[-1] * row_scale[:, None])) * 0.85).clamp(0.0, w3.FP8_MAX).to(torch.float8_e4m3fn).float()
+    for _ in range(iters):
+        eff = (sc * row_scale[:, None]).clamp_min(1e-30)
+        q = torch.bucketize(g / eff[:, :, None], mids)
+        qv = lv[q]
+        s_opt = (g * qv).sum(-1) / qv.square().sum(-1).clamp_min(1e-30)
+        row_scale = (s_opt.amax(-1) / w3.FP8_MAX).clamp_min(1e-12)
+        sc = (s_opt / row_scale[:, None]).clamp(0.0, w3.FP8_MAX).to(torch.float8_e4m3fn).float()
+    eff = (sc * row_scale[:, None]).clamp_min(1e-30)
+    codes = torch.bucketize(g / eff[:, :, None], mids, out_int32=True)
+    dq = lv[codes.long()] * eff[:, :, None]
+    alpha = (g * dq).sum((-1, -2)) / dq.square().sum((-1, -2)).clamp_min(1e-30)
+    row_scale = (row_scale * alpha).clamp_min(1e-12)
+    return codes.reshape(n, k), sc.to(torch.float8_e4m3fn), row_scale
+
