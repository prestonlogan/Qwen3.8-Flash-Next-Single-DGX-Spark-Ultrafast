diff --git a/hibana/engine/think_guard.py b/hibana/engine/think_guard.py
new file mode 100644
index 0000000..7f8a40b
--- /dev/null
+++ b/hibana/engine/think_guard.py
@@ -0,0 +1,508 @@
+"""Thinking budget, progressive soft-landing </think> bias, and code-aware repetition guard (THINK_GUARD v3.1).
+
+Adds on top of THINK_GUARD v3:
+  1. Progressive soft-landing </think> logit nudge (`think_close_bias(r)`):
+     - Disabled when HIBANA_THINK_SOFT_BIAS <= 0 (default 0.0).
+     - Completely 0.0 while think_tokens < T_start (default min(4096, 0.30 * max_new_tokens)),
+       so short/normal reasoning, math/code/tool tasks, and 200-prompt Reference KL are 100% untouched.
+     - Between T_start and T_end (default min(10240, 0.60 * max_new_tokens)), ramps linearly from
+       0.0 to +HIBANA_THINK_SOFT_BIAS on </think> (248069). Mid-sentence logit(</think>) is -18 to -25
+       so it never cuts mid-thought; at natural paragraph transitions it gently encourages the model to
+       close <think> and act/answer cleanly rather than over-planning to 24.6K tokens.
+  2. Clean newline-aligned hard budget close + post-close empty-EOS rescue:
+     - Hard budget cap remains as the last line of defense (0.75 * max_tokens, capped at 24576).
+     - When budget hits, waits up to 48 tokens for a newline/sentence boundary (198/271/13) so </think>
+       is not slammed mid-word; if the model emits EOS within 8 tokens of a forced </think> with zero
+       visible content or tool call, replaces EOS once with `\n\n` (271) so it produces its answer/action.
+  3. Code/tool-call aware visible repetition guard (Issue 1 fix):
+     - Tracks <tool_call> (248058) ... </tool_call> (248059) and ``` fences (71093, 52451).
+     - Never false-triggers on normal code n-gram repetition inside tool calls or code fences.
+     - Still catches real degenerate loops in thinking, visible prose, and stuck code loops.
+"""
+from __future__ import annotations
+
+import collections
+import os
+import sys
+
+_ENABLED = os.environ.get("HIBANA_THINK_GUARD", "0") == "1"
+_OPEN_ID = int(os.environ.get("HIBANA_THINK_OPEN_ID", "248068"))
+_CLOSE_ID = int(os.environ.get("HIBANA_THINK_CLOSE_ID", "248069"))
+_EOS_ID = int(os.environ.get("HIBANA_THINK_EOS_ID", "248046"))
+_TOOL_OPEN_ID = int(os.environ.get("HIBANA_TOOL_OPEN_ID", "248058"))
+_TOOL_CLOSE_ID = int(os.environ.get("HIBANA_TOOL_CLOSE_ID", "248059"))
+_FENCE_IDS = frozenset(
+    int(x)
+    for x in os.environ.get("HIBANA_CODE_FENCE_IDS", "71093,52451").split(",")
+    if x.strip()
+)
+_BOUNDARY_IDS = frozenset((198, 271, 13))  # '\n', '\n\n', '.'
+_NL2_ID = 271  # '\n\n'
+
+_BUDGET_FRAC = float(os.environ.get("HIBANA_THINK_BUDGET_FRAC", "0.75"))
+_ABS_MAX_THINK = int(os.environ.get("HIBANA_THINK_MAX_TOKENS", "24576"))
+_BUDGET_GRACE = int(os.environ.get("HIBANA_THINK_BUDGET_GRACE", "48"))
+_LOG = os.environ.get("HIBANA_THINK_GUARD_LOG", "1") != "0"
+
+# Progressive soft-landing </think> bias parameters (Issue 2 + Issue 3 fix; 0.0 = off)
+# Two-stage smooth ramp:
+#   [0 .. t_start]:         0.0 (100% bit-exact, zero KL delta, normal tasks untouched)
+#   [t_start .. t_mid]:     0.0 -> _SOFT_BIAS_MAX (gentle paragraph-boundary nudge)
+#   [t_mid .. t_firm]:      _SOFT_BIAS_MAX -> _SOFT_FIRM_BIAS (ensures clean natural close before budget cap)
+_SOFT_BIAS_MAX = float(os.environ.get("HIBANA_THINK_SOFT_BIAS", "0.0") or "0.0")
+_SOFT_FIRM_BIAS = float(os.environ.get("HIBANA_THINK_SOFT_FIRM_BIAS", "16.0") or "16.0")
+_SOFT_START_ABS = int(os.environ.get("HIBANA_THINK_SOFT_START", "3584") or "3584")
+_SOFT_END_ABS = int(os.environ.get("HIBANA_THINK_SOFT_END", "8192") or "8192")
+_SOFT_FIRM_ABS = int(os.environ.get("HIBANA_THINK_SOFT_FIRM_END", "12288") or "12288")
+_SOFT_START_FRAC = float(os.environ.get("HIBANA_THINK_SOFT_START_FRAC", "0.25") or "0.25")
+_SOFT_END_FRAC = float(os.environ.get("HIBANA_THINK_SOFT_END_FRAC", "0.50") or "0.50")
+_SOFT_FIRM_FRAC = float(os.environ.get("HIBANA_THINK_SOFT_FIRM_FRAC", "0.68") or "0.68")
+
+# Prose & thinking n-gram parameters
+_LONG_N = int(os.environ.get("HIBANA_TG_LONG_N", "24"))
+_LONG_WIN = int(os.environ.get("HIBANA_TG_LONG_WIN", "4096"))
+_LONG_THINK_K = int(os.environ.get("HIBANA_TG_LONG_THINK_K", "4"))
+_LONG_THINK_HARD_K = int(os.environ.get("HIBANA_TG_LONG_THINK_HARD_K", "6"))
+_LONG_THINK_NOV_MAX = float(os.environ.get("HIBANA_TG_LONG_THINK_NOV_MAX", "0.58"))
+_LONG_VIS_K = int(os.environ.get("HIBANA_TG_LONG_VIS_K", "3"))
+_LONG_VIS_HARD_K = int(os.environ.get("HIBANA_TG_LONG_VIS_HARD_K", "4"))
+_LONG_VIS_NOV_MAX = float(os.environ.get("HIBANA_TG_LONG_VIS_NOV_MAX", "0.58"))
+
+_SHORT_N = int(os.environ.get("HIBANA_TG_SHORT_N", "10"))
+_SHORT_WIN = int(os.environ.get("HIBANA_TG_SHORT_WIN", "512"))
+_SHORT_THINK_K = int(os.environ.get("HIBANA_TG_SHORT_THINK_K", "8"))
+_SHORT_VIS_K = int(os.environ.get("HIBANA_TG_SHORT_VIS_K", "6"))
+_SHORT_NOVELTY_MAX = float(os.environ.get("HIBANA_TG_NOVELTY_MAX", "0.45"))
+_SHORT_HARD_K = int(os.environ.get("HIBANA_TG_SHORT_HARD_K", "12"))
+_SHORT_HARD_NOV_MAX = float(os.environ.get("HIBANA_TG_SHORT_HARD_NOV_MAX", "0.65"))
+
+# Strict code / tool-call degenerate-loop parameters
+_CODE_LONG_N = int(os.environ.get("HIBANA_TG_CODE_LONG_N", "64"))
+_CODE_LONG_WIN = int(os.environ.get("HIBANA_TG_CODE_LONG_WIN", "2048"))
+_CODE_LONG_K = int(os.environ.get("HIBANA_TG_CODE_LONG_K", "6"))
+_CODE_NOVELTY_MAX = float(os.environ.get("HIBANA_TG_CODE_NOVELTY_MAX", "0.25"))
+_CODE_PERIODIC_REPS = int(os.environ.get("HIBANA_TG_CODE_PERIODIC_REPS", "12"))
+_CODE_PERIODIC_P1_REPS = int(os.environ.get("HIBANA_TG_CODE_PERIODIC_P1_REPS", "64"))
+
+
+class _PhaseWindow:
+    __slots__ = ("buf", "pos", "long_occ", "short_occ", "code_occ")
+
+    def __init__(self) -> None:
+        self.buf: list[int] = []
+        self.pos: int = 0
+        self.long_occ: dict[tuple[int, ...], collections.deque[int]] = {}
+        self.short_occ: dict[tuple[int, ...], collections.deque[int]] = {}
+        self.code_occ: dict[tuple[int, ...], collections.deque[int]] = {}
+
+    def _novelty_ratio(self, tail_len: int = 256) -> float:
+        tail = self.buf[-tail_len:]
+        n = len(tail)
+        if n < 64:
+            return 1.0
+        total = n - 7
+        uniq = len({tuple(tail[i : i + 8]) for i in range(total)})
+        return uniq / total
+
+    def _tail_periodic(self, min_reps: int = 6, min_p1_reps: int = 32, min_span_tokens: int = 0) -> int:
+        max_need = max(min_p1_reps, min_span_tokens, 64 * min_reps)
+        tail = self.buf[-max_need:]
+        n = len(tail)
+        if n < max(min_reps * 2, min_span_tokens):
+            return 0
+        req_p1 = max(min_p1_reps, min_span_tokens)
+        if n >= req_p1:
+            last = tail[-1]
+            if all(t == last for t in tail[-req_p1:]):
+                return 1
+        max_p = min(64, n // min_reps)
+        for p in range(2, max_p + 1):
+            reps = max(min_reps, (min_span_tokens + p - 1) // p) if min_span_tokens else min_reps
+            if n < p * reps:
+                continue
+            unit = tail[n - p :]
+            ok = True
+            for k in range(2, reps + 1):
+                if tail[n - k * p : n - (k - 1) * p] != unit:
+                    ok = False
+                    break
+            if ok:
+                return p
+        return 0
+
+    def push_and_check(self, tokens: list[int], mode: str) -> str | None:
+        if not tokens:
+            return None
+        if mode == "code":
+            return self._push_and_check_code(tokens)
+
+        is_think = mode == "think"
+        long_k = _LONG_THINK_K if is_think else _LONG_VIS_K
+        long_hard_k = _LONG_THINK_HARD_K if is_think else _LONG_VIS_HARD_K
+        long_nov_max = _LONG_THINK_NOV_MAX if is_think else _LONG_VIS_NOV_MAX
+        short_k = _SHORT_THINK_K if is_think else _SHORT_VIS_K
+        short_hard_k = (_SHORT_HARD_K + 4) if is_think else _SHORT_HARD_K
+        triggered: str | None = None
+
+        for tok in tokens:
+            self.buf.append(tok)
+            t = self.pos
+            self.pos += 1
+            blen = len(self.buf)
+
+            if blen >= _LONG_N:
+                gram = tuple(self.buf[-_LONG_N:])
+                dq = self.long_occ.get(gram)
+                if dq is None:
+                    dq = collections.deque()
+                    self.long_occ[gram] = dq
+                cutoff = t - _LONG_WIN
+                while dq and dq[0] < cutoff:
+                    dq.popleft()
+                if not dq or t - dq[-1] >= _LONG_N:
+                    dq.append(t)
+                    cnt = len(dq)
+                    if triggered is None:
+                        if cnt >= long_hard_k:
+                            triggered = f"long_n{_LONG_N}_k{cnt}"
+                        elif cnt >= long_k and self._novelty_ratio() < long_nov_max:
+                            triggered = f"long_lownov_n{_LONG_N}_k{cnt}"
+
+            if blen >= _SHORT_N:
+                gram = tuple(self.buf[-_SHORT_N:])
+                dq = self.short_occ.get(gram)
+                if dq is None:
+                    dq = collections.deque()
+                    self.short_occ[gram] = dq
+                cutoff = t - _SHORT_WIN
+                while dq and dq[0] < cutoff:
+                    dq.popleft()
+                if not dq or t - dq[-1] >= _SHORT_N:
+                    dq.append(t)
+                    cnt = len(dq)
+                    if triggered is None:
+                        if cnt >= short_hard_k and self._novelty_ratio() < _SHORT_HARD_NOV_MAX:
+                            triggered = f"short_hard_n{_SHORT_N}_k{cnt}"
+                        elif cnt >= short_k and self._novelty_ratio() < _SHORT_NOVELTY_MAX:
+                            triggered = f"short_lownov_n{_SHORT_N}_k{cnt}"
+
+        if len(self.buf) > _LONG_WIN + 512:
+            self.buf = self.buf[-_LONG_WIN:]
+            lcut = self.pos - _LONG_WIN
+            scut = self.pos - _SHORT_WIN
+            self.long_occ = {k: v for k, v in self.long_occ.items() if v and v[-1] >= lcut}
+            self.short_occ = {k: v for k, v in self.short_occ.items() if v and v[-1] >= scut}
+
+        if triggered is None and self.pos >= 64:
+            p = self._tail_periodic(min_reps=(8 if is_think else 6), min_p1_reps=32, min_span_tokens=64)
+            if p:
+                triggered = f"periodic_p{p}"
+        return triggered
+
+    def _push_and_check_code(self, tokens: list[int]) -> str | None:
+        triggered: str | None = None
+        for tok in tokens:
+            self.buf.append(tok)
+            t = self.pos
+            self.pos += 1
+            if len(self.buf) >= _CODE_LONG_N:
+                gram = tuple(self.buf[-_CODE_LONG_N:])
+                dq = self.code_occ.get(gram)
+                if dq is None:
+                    dq = collections.deque()
+                    self.code_occ[gram] = dq
+                cutoff = t - _CODE_LONG_WIN
+                while dq and dq[0] < cutoff:
+                    dq.popleft()
+                if not dq or t - dq[-1] >= _CODE_LONG_N:
+                    dq.append(t)
+                    cnt = len(dq)
+                    if cnt >= _CODE_LONG_K and triggered is None and self._novelty_ratio(256) < _CODE_NOVELTY_MAX:
+                        triggered = f"code_long_n{_CODE_LONG_N}_k{cnt}"
+
+        if len(self.buf) > _CODE_LONG_WIN + 512:
+            self.buf = self.buf[-_CODE_LONG_WIN:]
+            ccut = self.pos - _CODE_LONG_WIN
+            self.code_occ = {k: v for k, v in self.code_occ.items() if v and v[-1] >= ccut}
+
+        if triggered is None and self.pos >= 128:
+            p = self._tail_periodic(
+                min_reps=_CODE_PERIODIC_REPS,
+                min_p1_reps=_CODE_PERIODIC_P1_REPS,
+                min_span_tokens=128,
+            )
+            if p:
+                triggered = f"code_periodic_p{p}"
+        return triggered
+
+
+class _GuardState:
+    __slots__ = (
+        "phase",
+        "forced_close",
+        "think_tokens",
+        "vis_tokens",
+        "win",
+        "stopped",
+        "in_tool_call",
+        "in_code_fence",
+        "rescued_post_close",
+    )
+
+    def __init__(self, in_think: bool) -> None:
+        self.phase: str = "think" if in_think else "visible"
+        self.forced_close: bool = False
+        self.think_tokens: int = 0
+        self.vis_tokens: int = 0
+        self.win: _PhaseWindow = _PhaseWindow()
+        self.stopped: bool = False
+        self.in_tool_call: bool = False
+        self.in_code_fence: bool = False
+        self.rescued_post_close: bool = False
+
+
+def _detect_starts_in_think(r, emitted: list[int]) -> bool:
+    prompt_ids = getattr(r, "prompt_ids", None) or ()
+    tail_p = prompt_ids[-32:] if prompt_ids else ()
+    if _OPEN_ID in tail_p:
+        last_open = -1
+        last_close = -1
+        for i, tid in enumerate(tail_p):
+            if tid == _OPEN_ID:
+                last_open = i
+            elif tid == _CLOSE_ID:
+                last_close = i
+        if last_open > last_close:
+            return True
+    out_head = getattr(r, "output_ids", ())[:16]
+    if _OPEN_ID in out_head or _OPEN_ID in emitted:
+        return True
+    return False
+
+
+def _log(r, msg: str) -> None:
+    if _LOG:
+        rid = getattr(r, "request_id", "?")
+        print(f"think_guard: req={rid} {msg}", file=sys.stderr, flush=True)
+
+
+def _latch_exact(r) -> None:
+    params = getattr(r, "params", None)
+    if params is not None and not getattr(params, "greedy", False) and getattr(params, "accept_soft", 0.0) > 0.0:
+        params.accept_soft = 0.0
+
+
+def think_close_bias(r) -> float:
+    """Return the progressive </think> logit bias for request r (0.0 when inactive or below start threshold)."""
+    if _SOFT_BIAS_MAX <= 0.0:
+        return 0.0
+    params = getattr(r, "params", None)
+    if params is None or getattr(params, "ignore_eos", False):
+        return 0.0
+    st: _GuardState | None = getattr(r, "_tg_v2", None)
+    if st is None:
+        # Works even when HIBANA_THINK_GUARD=0 by inspecting prompt/output_ids directly
+        out_ids = getattr(r, "output_ids", ())
+        if _CLOSE_ID in out_ids:
+            return 0.0
+        if not _detect_starts_in_think(r, []):
+            return 0.0
+        think_toks = len(out_ids)
+    else:
+        if st.phase != "think":
+            return 0.0
+        think_toks = st.think_tokens
+
+    max_tok = getattr(params, "max_new_tokens", 0) or 0
+    if max_tok >= 256:
+        t_start = min(_SOFT_START_ABS, int(_SOFT_START_FRAC * max_tok))
+        t_mid = min(_SOFT_END_ABS, int(_SOFT_END_FRAC * max_tok))
+        t_firm = min(_SOFT_FIRM_ABS, int(_SOFT_FIRM_FRAC * max_tok))
+    else:
+        t_start = _SOFT_START_ABS
+        t_mid = _SOFT_END_ABS
+        t_firm = _SOFT_FIRM_ABS
+    if t_mid <= t_start:
+        t_mid = t_start + 512
+    if t_firm <= t_mid:
+        t_firm = t_mid + 512
+    if think_toks < t_start:
+        return 0.0
+    if think_toks <= t_mid:
+        frac = (think_toks - t_start) / float(t_mid - t_start)
+        return frac * _SOFT_BIAS_MAX
+    firm = max(_SOFT_BIAS_MAX, _SOFT_FIRM_BIAS)
+    frac2 = min(1.0, (think_toks - t_mid) / float(t_firm - t_mid))
+    return _SOFT_BIAS_MAX + frac2 * (firm - _SOFT_BIAS_MAX)
+
+
+def _push_visible_tokens(st: _GuardState, tokens: list[int]) -> tuple[str | None, str]:
+    seg: list[int] = []
+
+    def _cur_ctx() -> tuple[str, str]:
+        if st.in_tool_call:
+            return "code", "tool_call"
+        if st.in_code_fence:
+            return "code", "code_fence"
+        return "prose", "prose"
+
+    for tok in tokens:
+        if tok == _TOOL_OPEN_ID and not st.in_tool_call:
+            if seg:
+                mode, ctx = _cur_ctx()
+                rep = st.win.push_and_check(seg, mode=mode)
+                seg.clear()
+                if rep is not None:
+                    return rep, ctx
+            st.in_tool_call = True
+            st.in_code_fence = False
+            st.win = _PhaseWindow()
+            continue
+
+        if tok == _TOOL_CLOSE_ID and st.in_tool_call:
+            if seg:
+                rep = st.win.push_and_check(seg, mode="code")
+                seg.clear()
+                if rep is not None:
+                    return rep, "tool_call"
+            st.in_tool_call = False
+            st.in_code_fence = False
+            st.win = _PhaseWindow()
+            continue
+
+        if not st.in_tool_call and tok in _FENCE_IDS:
+            if seg:
+                mode, ctx = _cur_ctx()
+                rep = st.win.push_and_check(seg, mode=mode)
+                seg.clear()
+                if rep is not None:
+                    return rep, ctx
+            st.in_code_fence = not st.in_code_fence
+            st.win = _PhaseWindow()
+            continue
+
+        seg.append(tok)
+
+    if seg:
+        mode, ctx = _cur_ctx()
+        rep = st.win.push_and_check(seg, mode=mode)
+        if rep is not None:
+            return rep, ctx
+    _, ctx = _cur_ctx()
+    return None, ctx
+
+
+def apply_think_guard(r, emitted: list[int], enabled_override: bool | None = None) -> list[int]:
+    enabled = _ENABLED if enabled_override is None else enabled_override
+    if not enabled or not emitted:
+        return emitted
+
+    st: _GuardState | None = getattr(r, "_tg_v2", None)
+    if st is None:
+        st = _GuardState(_detect_starts_in_think(r, emitted))
+        r._tg_v2 = st
+
+    if st.stopped:
+        return emitted
+
+    params = getattr(r, "params", None)
+    max_tok = (getattr(params, "max_new_tokens", 0) or 0) if params is not None else 0
+    stops = (getattr(params, "stop_token_ids", ()) or ()) if params is not None else ()
+    ignore_eos = bool(getattr(params, "ignore_eos", False)) if params is not None else False
+    out_len = len(getattr(r, "output_ids", ())) + len(emitted)
+
+    if st.phase == "think" and _CLOSE_ID in emitted:
+        idx = emitted.index(_CLOSE_ID)
+        st.think_tokens += idx + 1
+        st.phase = "visible"
+        st.in_tool_call = False
+        st.in_code_fence = False
+        st.win = _PhaseWindow()
+        tail_vis = emitted[idx + 1 :]
+        if tail_vis:
+            st.vis_tokens += len(tail_vis)
+            _push_visible_tokens(st, tail_vis)
+        return emitted
+
+    if st.phase == "think":
+        st.think_tokens += len(emitted)
+        # 1. Rescue premature EOS inside <think>
+        if (
+            not ignore_eos
+            and not st.forced_close
+            and emitted[-1] in stops
+            and st.think_tokens >= 64
+            and (max_tok == 0 or (max_tok - out_len) >= 64)
+        ):
+            out = list(emitted)
+            out[-1] = _CLOSE_ID
+            st.phase = "visible"
+            st.forced_close = True
+            st.in_tool_call = False
+            st.in_code_fence = False
+            st.win = _PhaseWindow()
+            _latch_exact(r)
+            _log(r, f"type=premature_eos rescued premature EOS inside <think> at out_len={out_len}")
+            return out
+
+        # 2. Thinking budget cap (last line of defense, waits up to _BUDGET_GRACE tokens for newline/sentence end)
+        budget_hit = False
+        budget = _ABS_MAX_THINK
+        if max_tok >= 64:
+            budget = min(max(32, int(_BUDGET_FRAC * max_tok)), _ABS_MAX_THINK)
+            if out_len >= budget:
+                if (emitted[-1] in _BOUNDARY_IDS) or (out_len >= budget + _BUDGET_GRACE) or (max_tok - out_len <= 64):
+                    budget_hit = True
+        elif st.think_tokens >= _ABS_MAX_THINK:
+            if (emitted[-1] in _BOUNDARY_IDS) or (st.think_tokens >= _ABS_MAX_THINK + _BUDGET_GRACE):
+                budget_hit = True
+
+        # 3. Multi-scale repetition check inside <think>
+        rep_reason = st.win.push_and_check(emitted, mode="think")
+
+        if budget_hit or rep_reason is not None:
+            out = list(emitted)
+            if emitted[-1] not in stops or not st.forced_close:
+                out[-1] = _CLOSE_ID
+                st.phase = "visible"
+                st.forced_close = True
+                st.in_tool_call = False
+                st.in_code_fence = False
+                st.win = _PhaseWindow()
+                if rep_reason is not None:
+                    _latch_exact(r)
+                    _log(r, f"type=think_rep closed <think> on {rep_reason} at out_len={out_len}")
+                else:
+                    _log(r, f"type=budget closed <think> on budget(out={out_len},max={max_tok})")
+                return out
+        return emitted
+
+    # Visible phase: rescue immediate empty EOS right after a forced budget close
+    if not ignore_eos and emitted[-1] in stops:
+        if (
+            st.forced_close
+            and not st.rescued_post_close
+            and st.vis_tokens + len(emitted) <= 8
+            and (max_tok == 0 or (max_tok - out_len) >= 64)
+        ):
+            out = list(emitted)
+            out[-1] = _NL2_ID
+            st.rescued_post_close = True
+            st.vis_tokens += len(emitted)
+            _log(r, f"type=post_close_eos rescued immediate empty EOS after forced </think> at out_len={out_len}")
+            return out
+        st.stopped = True
+        return emitted
+
+    st.vis_tokens += len(emitted)
+    rep_reason, ctx = _push_visible_tokens(st, emitted)
+    if rep_reason is not None:
+        if not ignore_eos:
+            eos_id = int(stops[0]) if stops else _EOS_ID
+            out = list(emitted)
+            out[-1] = eos_id
+            st.stopped = True
+            _log(r, f"type=visible_rep ctx={ctx} stopped visible repetition loop on {rep_reason} at out_len={out_len}")
+            return out
+        _latch_exact(r)
+    return emitted
