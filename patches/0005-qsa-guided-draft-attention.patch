+        rows, entry = min(candidates, key=lambda item: item[0])
+        flat = row * steps + min(count - 1, steps - 1)
+        if flat >= entry[0].shape[0]:
+            return
+        state = self._state(req)
+        state.qsa_guide_pages = entry[0][flat, :self.qsa_guide_width].clone()
 
