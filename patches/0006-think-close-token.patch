diff --git a/hibana/engine/think_close.py b/hibana/engine/think_close.py
new file mode 100644
index 0000000..31fdf84
--- /dev/null
+++ b/hibana/engine/think_close.py
@@ -0,0 +1,194 @@
+"""Mask the thinking-close token except where a real close can happen.
+
+The checkpoint's </think> is one ordinary added token, so a model that quotes
+or explains the tag inside reasoning emits it mid-sentence and the turn ends
+with an empty answer or thinking cut in two. While a request is inside thinking
+the close id is masked wherever a token is chosen, unless the previous token's
+text ends in a newline: the chat template closes thinking as "\\n</think>\\n\\n".
+Forced closes (think_guard's budget and repetition rewrites) bypass sampling and
+are unaffected. The parser ends reasoning on the token id, not the text
+"</think>", so a tag spelled with ordinary tokens stays inside reasoning.
+"""
+from __future__ import annotations
+
+import torch
+
+from hibana.engine.think_guard import _CLOSE_ID as CLOSE_ID, _OPEN_ID as OPEN_ID
+
+# The turn-ending stop tokens (im_end, endoftext): never legal inside thinking.
+# Masking only the close id routes quote-intent into EOS, which the think
+# guard's premature-EOS rescue then converts into a forced early close.
+EOS_IDS = (248046, 248044)
+
+
+def install(ex, tok) -> None:
+    """Attach the ends-in-newline and fence-count tables plus a decode fn to the
+    executor (`ex`). `tok` is the api SnapshotTokenizer."""
+    vocab = tok._tok.get_vocab(with_added_tokens=True)
+    size = max(vocab.values()) + 1
+    table = torch.zeros(size, dtype=torch.bool)
+    global _FENCE_HOST, _BT_HOST, _DQ_HOST
+    _FENCE_HOST = [0] * size
+    _BT_HOST = [(0, 0, 0)] * size  # (has newline, backticks in whole token, backticks after its last newline)
+    _DQ_HOST = [(0, 0, 0)] * size  # same for double quotes
+    fence = torch.zeros(size, dtype=torch.int32)
+    bt = torch.zeros(size, dtype=torch.int32)
+    dq = torch.zeros(size, dtype=torch.int32)
+    for surface, i in vocab.items():
+        if surface.endswith("Ċ") or surface.endswith("\n"):
+            table[i] = True
+        n = surface.count("```")
+        if n:
+            _FENCE_HOST[i] = n
+            fence[i] = n
+        nl_at = max(surface.rfind("Ċ"), surface.rfind("\n"))
+        tail = surface[nl_at + 1:] if nl_at >= 0 else surface
+        if "`" in surface:
+            _BT_HOST[i] = (1 if nl_at >= 0 else 0, surface.count("`"), tail.count("`"))
+            bt[i] = surface.count("`")
+        if '"' in surface:
+            _DQ_HOST[i] = (1 if nl_at >= 0 else 0, surface.count('"'), tail.count('"'))
+            dq[i] = surface.count('"')
+    ex._think_nl = table.to(ex.device)
+    ex._think_fence = fence.to(ex.device)
+    ex._think_bt = bt.to(ex.device)
+    ex._think_dq = dq.to(ex.device)
+    ex._think_decode = lambda ids: tok.decode(ids, skip_special_tokens=True)
+
+
+_FENCE_HOST: list[int] = []  # "```" count per token id, set by install
+_BT_HOST: list[tuple[int, int, int]] = []  # (has newline, ` count, ` count after last newline) per token
+_DQ_HOST: list[tuple[int, int, int]] = []  # same for double quotes
+
+
+def think_open(r, decode=None) -> bool:
+    """Whether request r is still inside its thinking block (cached on r)."""
+    st = getattr(r, "_think_open", None)
+    if st is None:
+        st = _detect(r, decode)
+        r._think_open = st
+    return st
+
+
+def _detect(r, decode) -> bool:
+    prompt = getattr(r, "prompt_ids", None) or ()
+    tail = prompt[-32:]
+    last_open = last_close = -1
+    for i, t in enumerate(tail):
+        if t == OPEN_ID:
+            last_open = i
+        elif t == CLOSE_ID:
+            last_close = i
+    if last_open > last_close:
+        return True
+    out = getattr(r, "output_ids", ())
+    if not out:
+        return False
+    if decode is not None:
+        return decode(list(out[:8])).startswith("<think>")
+    return out[0] == OPEN_ID
+
+
+def note(r, token: int) -> None:
+    """Track thinking state from each emitted token (Request.push)."""
+    if token == CLOSE_ID:
+        r._think_open = False
+    elif token == OPEN_ID and len(getattr(r, "output_ids", ())) <= 1:
+        r._think_open = True
+    if _FENCE_HOST and token < len(_FENCE_HOST) and _FENCE_HOST[token]:
+        r._fence_par = (getattr(r, "_fence_par", 0) + _FENCE_HOST[token]) & 1
+    # Inline code span and quote parity on the current line: a token with a
+    # newline starts a new line at its tail, else counts accumulate.
+    if _BT_HOST and token < len(_BT_HOST):
+        nl, full, tail = _BT_HOST[token]
+        r._line_bt = (tail if nl else getattr(r, "_line_bt", 0) + full) & 1
+        nl, full, tail = _DQ_HOST[token]
+        r._line_dq = (tail if nl else getattr(r, "_line_dq", 0) + full) & 1
+
+
+def fence_par(r) -> int:
+    """Whether the reasoning text so far has an odd count of ``` fences."""
+    return getattr(r, "_fence_par", 0)
+
+
+def line_state(r) -> tuple[int, int]:
+    """Backtick and double-quote parity on the request's current line."""
+    return getattr(r, "_line_bt", 0), getattr(r, "_line_dq", 0)
+
+
+def _flags(requests, decode) -> list[bool] | None:
+    flags = [think_open(r, decode) for r in requests]
+    return flags if any(flags) else None
+
+
+def verify(logits, requests, drafts, prev, nl, decode=None, fence=None, bt=None, dq=None) -> bool:
+    """Mask CLOSE_ID in verify logits [b * s, V] where a real close cannot
+    happen. `drafts` [b, k] are the round's proposals (s = k + 1); `prev` [b * s]
+    is each row's input token, the token the row's prediction follows. Rows past
+    a drafted close are already out of thinking. A close is legal only after a
+    newline-ending token outside an open code fence. Returns True when applied."""
+    if nl is None or CLOSE_ID >= logits.shape[-1]:
+        return False
+    flags = _flags(requests, decode)
+    if flags is None:
+        return False
+    device = logits.device
+    committed = torch.tensor(flags, dtype=torch.bool, pin_memory=device.type == "cuda").to(device, non_blocking=True)
+    saw = (drafts == CLOSE_ID).to(torch.int64).cumsum(1)  # [b, k] closes through each draft
+    before = torch.nn.functional.pad(saw, (1, 0))  # [b, k + 1]: closes in drafts[:, :j]
+    open_rows = committed.unsqueeze(1) & (before == 0)  # [b, s]
+    prev_t = prev.to(device, non_blocking=True) if prev.device != device else prev
+    legal = nl[prev_t]  # [b * s]: newline-ending previous token
+    if fence is not None:
+        parity = torch.tensor([fence_par(r) for r in requests], dtype=torch.int32,
+                              pin_memory=device.type == "cuda").to(device, non_blocking=True)
+        fc = fence[drafts].to(torch.int32).cumsum(1)  # [b, k] fence count through each draft
+        fc = torch.nn.functional.pad(fc, (1, 0))  # [b, k + 1]: count in drafts[:, :j]
+        inside = ((parity.unsqueeze(1) + fc) % 2).reshape(-1).bool()  # [b * s]
+        legal = legal & ~inside
+    if bt is not None and dq is not None:
+        # Backtick and double-quote parity on the current line: committed state
+        # plus a cumulative count over the drafts (newline resets inside the
+        # block are not re-tracked; the abuse line has none).
+        line_host = [[*line_state(r)] for r in requests]
+        lp = torch.tensor(line_host, dtype=torch.int32, pin_memory=device.type == "cuda").to(device, non_blocking=True)
+        for bit, tab in ((0, bt), (1, dq)):
+            cc = tab[drafts].to(torch.int32).cumsum(1)
+            cc = torch.nn.functional.pad(cc, (1, 0))
+            odd = ((lp[:, bit].unsqueeze(1) + cc) % 2).reshape(-1).bool()
+            legal = legal & ~odd
+    cond = open_rows.reshape(-1) & ~legal
+    logits[:, CLOSE_ID].masked_fill_(cond, float("-inf"))
+    open_flat = open_rows.reshape(-1)
+    for eos in EOS_IDS:
+        if eos < logits.shape[-1]:
+            logits[:, eos].masked_fill_(open_flat, float("-inf"))
+    return True
+
+
+def sample(logits, requests, prev_ids, nl, decode=None, fence_par_flags=None) -> bool:
+    """Mask CLOSE_ID in logits [b, V] for one position per request; `prev_ids`
+    are the host-side tokens each prediction follows (last output or prompt id).
+    `fence_par_flags` are the requests' fence parities (1: inside an open fence)."""
+    if nl is None or CLOSE_ID >= logits.shape[-1]:
+        return False
+    flags = _flags(requests, decode)
+    if flags is None:
+        return False
+    device = logits.device
+    committed = torch.tensor(flags, dtype=torch.bool, pin_memory=device.type == "cuda").to(device, non_blocking=True)
+    prev_t = torch.tensor(list(prev_ids), dtype=torch.int64, pin_memory=device.type == "cuda").to(device, non_blocking=True)
+    legal = nl[prev_t]
+    if fence_par_flags is not None:
+        inside = torch.tensor(fence_par_flags, dtype=torch.bool, pin_memory=device.type == "cuda").to(device, non_blocking=True)
+        legal = legal & ~inside
+    line_host = [[*line_state(r)] for r in requests]
+    if any(any(row) for row in line_host):
+        lp = torch.tensor(line_host, dtype=torch.bool, pin_memory=device.type == "cuda").to(device, non_blocking=True)
+        legal = legal & ~lp.any(1)
+    cond = committed & ~legal
+    logits[:, CLOSE_ID].masked_fill_(cond, float("-inf"))
+    for eos in EOS_IDS:
+        if eos < logits.shape[-1]:
+            logits[:, eos].masked_fill_(committed, float("-inf"))
+    return True
